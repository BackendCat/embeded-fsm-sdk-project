{
  "machineFile": "motor.fsm",
  "description": "Walk every state and every transition in Motor. The intended path is Idle → Running → Idle → Running → Faulted (after-timer) → Idle → Running → Faulted (FAULT) → Idle. The `after 5000 ms` timer in Running currently does not transition to Faulted (P0-4); the recorded `expected` reflects observed behaviour and must be re-recorded once the timer fix lands.",
  "init": {
    "machineName": "Motor",
    "externReturns": { "can_start": { "type": "bool", "value": true } }
  },
  "steps": [
    { "action": "dispatch", "event": "START" },
    { "action": "dispatch", "event": "STOP" },
    { "action": "dispatch", "event": "START" },
    { "action": "advance_clock", "deltaMs": 5001 },
    { "action": "dispatch", "event": "RESET" },
    { "action": "dispatch", "event": "START" },
    { "action": "dispatch", "event": "FAULT", "payload": { "code": { "type": "u8", "value": 7 } } },
    { "action": "dispatch", "event": "RESET" }
  ],
  "expected": [
    {
      "traceId": 0,
      "kind": "init",
      "virtualClockMs": 0,
      "enteredStates": ["s-Motor-Idle"],
      "configBefore": [],
      "configAfter": ["s-Motor-Idle"]
    },
    {
      "traceId": 1,
      "kind": "dispatched",
      "virtualClockMs": 0,
      "eventReceived": { "name": "START", "stableId": "M:Motor:event:START" },
      "transitionTaken": {
        "stableId": "M:Motor:transition:t-Motor-0",
        "source": "s-Motor-Idle",
        "target": "s-Motor-Running"
      },
      "exitedStates": ["s-Motor-Idle"],
      "enteredStates": ["s-Motor-Running"],
      "actionsExecuted": ["set_speed"],
      "configBefore": ["s-Motor-Idle"],
      "configAfter": ["s-Motor-Running"]
    },
    {
      "traceId": 2,
