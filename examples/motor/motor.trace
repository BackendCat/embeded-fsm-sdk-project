      "virtualClockMs": 0,
      "eventReceived": { "name": "STOP", "stableId": "M:Motor:event:STOP" },
      "transitionTaken": {
        "stableId": "M:Motor:transition:t-Motor-1",
        "source": "s-Motor-Running",
        "target": "s-Motor-Idle"
      },
      "exitedStates": ["s-Motor-Running"],
      "enteredStates": ["s-Motor-Idle"],
      "actionsExecuted": ["set_speed"],
      "configBefore": ["s-Motor-Running"],
      "configAfter": ["s-Motor-Idle"]
    },
    {
