{
  "machineFile": "vending-machine.fsm",
  "description": "Drive both parallel regions to their final states and confirm the outer Operational composite is exited via RESET to Done. After the audit P1-8 sibling fix (2026-05-14), `done` transitions on non-final states auto-fire, so DISPENSE drives ChangeAvailable -> PaymentFinal and Dispensing -> SelectionFinal in the same RTC cycle as the user-dispatched event. The second `DISPENSE` is therefore a no-op (both regions are already in their Final state), kept here to confirm idle behaviour.",
  "init": { "machineName": "VendingMachine" },
  "steps": [
    { "action": "dispatch", "event": "COIN", "payload": { "value": { "type": "u16", "value": 100 } } },
    { "action": "dispatch", "event": "COIN", "payload": { "value": { "type": "u16", "value": 100 } } },
    { "action": "dispatch", "event": "SELECT" },
    { "action": "dispatch", "event": "DISPENSE" },
    { "action": "dispatch", "event": "DISPENSE" },
    { "action": "dispatch", "event": "RESET" }
  ],
  "expected": [
