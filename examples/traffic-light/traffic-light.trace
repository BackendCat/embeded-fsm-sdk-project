{
  "machineFile": "traffic-light.fsm",
  "description": "Drive the Auto sub-region timer through Red, then OVERRIDE -> Manual, then RESUME via shallow_history back to Red. The intended path also cycles Red -> GreenAccelerating -> Green -> Yellow but the `after N ms` timers do not re-arm on entry today (P0-4); the recorded `expected` reflects observed behaviour and must be re-recorded once the timer fix lands.",
  "init": { "machineName": "TrafficLight" },
  "steps": [
    { "action": "advance_clock", "deltaMs": 2001 },
    { "action": "advance_clock", "deltaMs": 2001 },
    { "action": "advance_clock", "deltaMs": 30001 },
    { "action": "advance_clock", "deltaMs": 5001 },
    { "action": "dispatch", "event": "OVERRIDE" },
    { "action": "dispatch", "event": "RESUME" }
  ],
  "expected": [
    {
      "traceId": 0,
      "kind": "init",
      "virtualClockMs": 0,
      "enteredStates": ["s-TrafficLight-Auto", "s-TrafficLight-Red"],
      "configBefore": [],
      "configAfter": ["s-TrafficLight-Red"]
    },
    {
      "traceId": 1,
      "kind": "timer_fired",
      "virtualClockMs": 2000,
      "eventReceived": { "name": "__timer__:ps-timer-TrafficLight-2" },
      "configBefore": ["s-TrafficLight-Red"],
      "configAfter": ["s-TrafficLight-Red"]
    },
    {
      "traceId": 2,
      "kind": "dispatched",
      "virtualClockMs": 39004,
      "eventReceived": { "name": "OVERRIDE", "stableId": "M:TrafficLight:event:OVERRIDE" },
      "transitionTaken": {
        "stableId": "M:TrafficLight:transition:t-TrafficLight-0",
        "source": "s-TrafficLight-Auto",
        "target": "s-TrafficLight-Manual"
      },
      "exitedStates": ["s-TrafficLight-Red", "s-TrafficLight-Auto"],
      "enteredStates": ["s-TrafficLight-Manual"],
      "configBefore": ["s-TrafficLight-Red"],
      "configAfter": ["s-TrafficLight-Manual"]
    },
    {
      "traceId": 3,
      "kind": "dispatched",
      "virtualClockMs": 39004,
      "eventReceived": { "name": "RESUME", "stableId": "M:TrafficLight:event:RESUME" },
      "transitionTaken": {
        "stableId": "M:TrafficLight:transition:t-TrafficLight-1",
        "source": "s-TrafficLight-Manual",
        "target": "s-TrafficLight-HAuto"
      },
      "exitedStates": ["s-TrafficLight-Manual"],
