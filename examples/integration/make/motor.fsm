language fsm 2.0

feature timers

pure extern can_start() : bool
extern set_speed(u16 rpm)
extern reset_link()

machine Motor {
    context {
        count          : u32 = 0
        last_fault_code: u8  = 0
    }

    events {
        START
        STOP
        FAULT(code: u8)
        RESET
    }

    initial Idle

    state Idle {
        likely on START [can_start] -> Running : ctx.count = ctx.count + 1; set_speed(100)
    }

    state Running {
        after 5000 ms -> Faulted
        on STOP       -> Idle : set_speed(0)
        rare on FAULT -> Faulted : ctx.last_fault_code = payload.code; reset_link()
    }

    state Faulted {
        on RESET -> Idle
    }
}
