language fsm 2.0

// a line comment (legend index 9)
/* a block
   comment */
pure extern can_go(u8 n) : bool

machine Lift {
    context {
        floor: u8 = 0
    }

    events {
        CALL(dest: u16)
        STOP
    }

    initial Idle

    @id("s-idle")
    state Idle {
        on CALL [can_go(1) && ctx.floor == 0] -> Moving
    }

    state Moving {
        on STOP -> Idle : ctx.floor = ctx.floor + 1
        on CALL -> Moving
    }
}
