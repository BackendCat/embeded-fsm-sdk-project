language fsm 2.0

machine Lift {
    context {
        floor: u8 = 0
    }

    events {
        CALL(dest: u16)
        STOP
    }

    initial Idle

    state Idle {
        on CALL -> Moving
    }

    state Moving {
        on STOP -> Idle : ctx.floor = ctx.floor + 1
        on CALL -> Moving
    }
}
