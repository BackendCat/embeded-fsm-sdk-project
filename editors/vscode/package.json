{
  "name": "fsm-lang",
  "displayName": "FSM Studio",
  "description": "FSM-Lang language support, diagrams, verification, and codegen for embedded state machines.",
  "version": "1.0.0",
  "publisher": "fsmstudio",
  "license": "MIT",
  "icon": "assets/icon.png",
  "keywords": [
    "fsm",
    "state machine",
    "statechart",
    "embedded",
    "codegen",
    "verification",
    "model checking",
    "C",
    "language server"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BackendCat/embeded-fsm-sdk-project"
  },
  "galleryBanner": {
    "color": "#0D1117",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Visualization",
    "Debuggers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:fsm-lang",
    "workspaceContains:**/*.fsm",
    "onCommand:fsm.restartLanguageServer",
    "onCommand:fsm.showOutputChannel"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fsm-lang",
        "aliases": [
          "FSM-Lang",
          "fsm"
        ],
        "extensions": [
          ".fsm"
        ],
        "mimetypes": [
          "text/x-fsm-lang"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fsm-lang",
        "scopeName": "source.fsm",
        "path": "./syntaxes/fsm-lang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fsm-lang",
        "path": "./snippets/fsm-lang.json"
      }
    ],
    "commands": [
      {
        "command": "fsm.checkFile",
        "title": "Check File",
        "icon": "$(check-all)",
        "category": "FSM Studio"
      },
      {
        "command": "fsm.generateC99",
        "title": "Generate C99 Code",
        "icon": "$(export)",
        "category": "FSM Studio"
      },
      {
        "command": "fsm.generateCpp17",
        "title": "Generate C++17 Code",
        "icon": "$(export)",
        "category": "FSM Studio"
      },
      {
        "command": "fsm.copyIR",
        "title": "Copy IR JSON to Clipboard",
        "icon": "$(clippy)",
        "category": "FSM Studio"
      },
      {
        "command": "fsm.formatDocument",
        "title": "Format Document",
        "icon": "$(symbol-misc)",
        "category": "FSM Studio"
      },
      {
        "command": "fsm.restartLanguageServer",
        "title": "Restart Language Server",
        "icon": "$(refresh)",
        "category": "FSM Studio"
      },
      {
        "command": "fsm.showOutputChannel",
        "title": "Show Language Server Log",
        "category": "FSM Studio"
      },
      {
        "command": "fsm.openDiagram",
        "title": "Open Diagram",
        "icon": "$(type-hierarchy)",
        "category": "FSM Studio"
      },
      {
        "command": "fsm.refreshMachineExplorer",
        "title": "Refresh Machines",
        "icon": "$(refresh)",
        "category": "FSM Studio"
      },
      {
        "command": "fsm.refreshEventExplorer",
        "title": "Refresh Events",
        "icon": "$(refresh)",
        "category": "FSM Studio"
      },
      {
        "command": "fsm.verify",
        "title": "Verify (Deadlock-Freedom + Reachability)",
        "icon": "$(shield)",
        "category": "FSM Studio"
      },
      {
        "command": "fsm.baseline",
        "title": "Baseline Regression Check",
        "icon": "$(history)",
        "category": "FSM Studio"
      },
      {
        "command": "fsm.verifyLive",
        "title": "Verify Live (via Language Server)",
        "icon": "$(shield)",
        "category": "FSM Studio"
      }
    ],
    "keybindings": [
      {
        "command": "fsm.generateC99",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "editorLangId == fsm-lang"
      },
      {
        "command": "fsm.openDiagram",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorLangId == fsm-lang"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fsm.refreshMachineExplorer",
          "when": "view == fsm.machineExplorer",
          "group": "navigation"
        },
        {
          "command": "fsm.refreshEventExplorer",
          "when": "view == fsm.eventExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "fsm.refreshMachineExplorer",
          "when": "view == fsm.machineExplorer && viewItem == fsmSymbol",
          "group": "inline"
        },
        {
          "command": "fsm.refreshEventExplorer",
          "when": "view == fsm.eventExplorer && viewItem == fsmSymbol",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "fsm.openDiagram",
          "when": "editorLangId == fsm-lang",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "fsm.openDiagram",
          "when": "editorLangId == fsm-lang",
          "group": "fsm@1"
        },
        {
          "command": "fsm.generateC99",
          "when": "editorLangId == fsm-lang",
          "group": "fsm@3"
        },
        {
          "command": "fsm.generateCpp17",
          "when": "editorLangId == fsm-lang",
          "group": "fsm@4"
        },
        {
          "command": "fsm.formatDocument",
          "when": "editorLangId == fsm-lang",
          "group": "fsm@5"
        },
        {
          "command": "fsm.copyIR",
          "when": "editorLangId == fsm-lang",
          "group": "fsm@6"
        },
        {
          "command": "fsm.verify",
          "when": "editorLangId == fsm-lang",
          "group": "fsm@2"
        },
        {
          "command": "fsm.verifyLive",
          "when": "editorLangId == fsm-lang",
          "group": "fsm@2"
        },
        {
          "command": "fsm.baseline",
          "when": "editorLangId == fsm-lang",
          "group": "fsm@7"
        }
      ],
      "explorer/context": [
        {
          "command": "fsm.checkFile",
          "when": "resourceExtname == .fsm",
          "group": "fsm"
        },
        {
          "command": "fsm.generateC99",
          "when": "resourceExtname == .fsm",
          "group": "fsm"
        },
        {
          "command": "fsm.verify",
          "when": "resourceExtname == .fsm",
          "group": "fsm"
        },
        {
          "command": "fsm.verifyLive",
          "when": "resourceExtname == .fsm",
          "group": "fsm"
        }
      ],
      "commandPalette": [
        {
          "command": "fsm.openDiagram",
          "when": "editorLangId == fsm-lang"
        },
        {
          "command": "fsm.generateC99",
          "when": "editorLangId == fsm-lang"
        },
        {
          "command": "fsm.generateCpp17",
          "when": "editorLangId == fsm-lang"
        },
        {
          "command": "fsm.formatDocument",
          "when": "editorLangId == fsm-lang"
        },
        {
          "command": "fsm.checkFile",
          "when": "editorLangId == fsm-lang"
        },
        {
          "command": "fsm.copyIR",
          "when": "editorLangId == fsm-lang"
        },
        {
          "command": "fsm.verify",
          "when": "editorLangId == fsm-lang"
        },
        {
          "command": "fsm.verifyLive",
          "when": "editorLangId == fsm-lang"
        },
        {
          "command": "fsm.baseline",
          "when": "editorLangId == fsm-lang"
        },
        {
          "command": "fsm.restartLanguageServer"
        },
        {
          "command": "fsm.showOutputChannel"
        },
        {
          "command": "fsm.refreshMachineExplorer",
          "when": "false"
        },
        {
          "command": "fsm.refreshEventExplorer",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "FSM Studio",
      "properties": {
        "fsmLang.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the fsm-lang-server binary. Leave empty to use the bundled binary for this platform.",
          "scope": "machine-overridable"
        },
        "fsmLang.enableInlayHints": {
          "type": "boolean",
          "default": true,
          "description": "Show inlay hints (priority values, timer durations, state counts)."
        },
        "fsmLang.inlayHints.showTransitionPriorities": {
          "type": "boolean",
          "default": true,
          "description": "Show priority values on non-default priority transitions."
        },
        "fsmLang.inlayHints.showStateTypes": {
          "type": "boolean",
          "default": false,
          "description": "Show state kind labels (composite, parallel) next to state names."
        },
        "fsmLang.inlayHints.showTimerDurations": {
          "type": "boolean",
          "default": true,
          "description": "Show human-readable duration next to timer ms values."
        },
        "fsmLang.codegen.outputDir": {
          "type": "string",
          "default": "generated",
          "markdownDescription": "Output directory for the **Generate C99 Code** / **Generate C++17 Code** commands (maps to `fsm generate --out`). A relative path is rooted at the `.fsm` file's workspace folder (or, with no folder, the file's own directory).",
          "scope": "resource"
        },
        "fsmLang.codegen.strategy": {
          "type": "string",
          "enum": [
            "switch",
            "table",
            "auto"
          ],
          "enumDescriptions": [
            "Emit a switch-based dispatcher.",
            "Emit a table-driven dispatcher.",
            "Let the compiler pick per machine (the CLI default)."
          ],
          "default": "switch",
          "markdownDescription": "Transition-dispatch strategy for generated code (maps to `fsm generate --strategy`). A per-machine `[machine.<Name>] strategy` in `fsm.toml` overrides this.",
          "scope": "resource"
        },
        "fsmLang.codegen.queueSize": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "maximum": 128,
          "markdownDescription": "Event-queue capacity for generated code (maps to `fsm generate --queue-size`). Must be a power of two; leave empty to use the compiler/`fsm.toml` default.",
          "scope": "resource"
        },
        "fsmLang.codegen.license": {
          "type": "string",
          "default": "MIT",
          "markdownDescription": "SPDX license identifier embedded in every generated file's header (maps to `fsm generate --license`).",
          "scope": "resource"
        },
        "fsmLang.codegen.emitIr": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also write the IR JSON next to the generated sources (maps to `fsm generate --emit-ir`)."
        },
        "fsmLang.codegen.reportMemory": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Print the computed memory budget to the FSM Studio log after emission (maps to `fsm generate --report-memory`)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fsm-explorer",
          "title": "FSM Studio",
          "icon": "./assets/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "fsm-explorer": [
        {
          "id": "fsm.machineExplorer",
          "name": "Machines",
          "when": "fsm.hasOpenFsmFile"
        },
        {
          "id": "fsm.eventExplorer",
          "name": "Events",
          "when": "fsm.hasOpenFsmFile"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fsm.machineExplorer",
        "when": "!fsm.hasOpenFsmFile",
        "contents": "Open a .fsm file to explore its machines, states, and transitions.\nThe outline is the language server's live document symbols — it stays in sync as you edit."
      },
      {
        "view": "fsm.eventExplorer",
        "when": "!fsm.hasOpenFsmFile",
        "contents": "Open a .fsm file to explore the events each machine declares."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle && npm run populate:bin",
    "compile": "tsc -p ./ && node copy-fixtures.mjs",
    "typecheck": "tsc --noEmit -p ./ && tsc --noEmit -p ./tsconfig.webview.json",
    "lint": "eslint src --ext ts",
    "bundle": "node esbuild.mjs",
    "populate:bin": "node scripts/populate-bin.mjs",
    "package": "vsce package --no-dependencies --out fsm-lang.vsix",
    "pretest": "tsc -p ./ && tsc --noEmit -p ./tsconfig.webview.json && node copy-fixtures.mjs && node esbuild.mjs",
    "test": "node ./out/test/runTest.js",
    "pretest:v6": "tsc -p ./ && node copy-fixtures.mjs && node esbuild.mjs",
    "test:v6": "node ./out/test/runTestV6.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.2",
    "eslint": "^8.57.0",
    "glob": "^10.3.12",
    "mocha": "^10.4.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "elkjs": "^0.11.1",
    "vscode-languageclient": "^9.0.1"
  }
}
